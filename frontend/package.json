{
  "name": "rfp-agent-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-tokens.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "gen:api": "cd ../backend && uv run rfp-openapi > ../frontend/openapi.json && cd ../frontend && node scripts/gen-api-types.mjs",
    "check:api": "node scripts/check-api-types.mjs",
    "trace": "node scripts/trace.mjs",
    "check:trace": "node scripts/trace.mjs --check && node --test scripts/trace.test.mjs scripts/sync-main.test.mjs",
    "sync-main": "node scripts/sync-main.mjs",
    "test:trace": "node --test scripts/trace.test.mjs",
    "compare:mockup": "node scripts/compare-mockup.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
