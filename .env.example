# 로컬 실행용. 복사해서 .env 로 쓰고, .env 는 커밋하지 않는다.
DATABASE_URL=postgresql://rfp:rfp@localhost:5433/rfp
# Gemini API 키. 비워 두면 언어 모델이 필요한 단계는 동작하지 않는다.
GEMINI_API_KEY=
# 쓸 Gemini 모델 이름. 줄을 지우면 기본값 gemini-3.8-flash를 쓴다.
GEMINI_MODEL=gemini-3.8-flash
# AI 사용 방식 (add-ai-mode): gemini(외부로 보냄, 요금) | local(사내 OpenAI 호환 주소) | off(규칙만).
# off이면 키가 있어도 보내지 않는다. 비용·외부 전송을 막으려면 off. 상태는 /api/health의 ai_mode·external_send.
RFP_AI_MODE=gemini
# local일 때만: 사내 주소(예: http://llm.사내/v1), 모델, 키, 문장 벡터 모델(비우면 뜻 찾기 건너뜀)
RFP_LOCAL_LLM_URL=
RFP_LOCAL_LLM_MODEL=
RFP_LOCAL_LLM_KEY=
RFP_LOCAL_EMBED_MODEL=
# AI 40줄 묶음을 동시에 몇 개 보낼지(1이면 차례로)와 요청 하나의 시간 제한(초) (NFR-10).
# AI 요청 한도(429 오류)에 자주 걸리면 동시 개수를 1~2로 줄인다.
RFP_LLM_WORKERS=4
RFP_LLM_TIMEOUT_S=120
# 프롬프트 평가(rfp-db eval-prompts) 한 번의 비용 상한(원, 팀 가정 단가). 넘으면 --yes가 있어야 시작
RFP_EVAL_MAX_KRW=500
# 여러 회사 모델 비교 평가(rfp-db eval-prompts --models, add-model-compare). 평가 전용 키
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 단가 표에 없는 모델의 단가(팀 가정, 1M 토큰당 달러). 예: gpt-x=0.4/1.6;qwen2.5:7b=0/0
RFP_EVAL_PRICES=
# 한 검토의 문서를 동시에 처리하는 개수(add-document-processors)와 OCR on|off(add-ocr)
RFP_DOC_WORKERS=2
RFP_OCR=on
# 검토 실행 대기열 (add-run-queue): inline(웹 서버가 직접, 기본) | worker(rfp-worker가 분석)
RFP_RUN_MODE=inline
RFP_RUN_WORKERS=2
RFP_UPLOAD_MAX_MB=100
RFP_REQUEST_MAX_MB=300
# AI 호출 기록 원문 저장 (add-ai-call-trace): off(해시만, 기본) | on(7일 보관, 고객 문서 환경에서는 켜지 않음)
RFP_TRACE_RAW=off
# Langfuse 프롬프트 관리 (add-langfuse-prompts): off(코드 판만, 기본) | on(Langfuse의 RFP_LANGFUSE_LABEL 판, 문제가 있으면 코드 판)
# self-host Langfuse 주소와 프로젝트 키. 클라우드 주소에는 RFP 원문이 든 호출 기록을 보내지 않는다
RFP_LANGFUSE=off
RFP_LANGFUSE_LABEL=production
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 협조 요청 메일 (update-role-handoff-mail). 로컬 기본값은 docker compose의 Mailpit(밖으로 안 나감).
# 받은 메일은 http://localhost:8025 에서 본다. 실제 사내 서버는 값만 바꾼다. 부서 주소를 비우면 그 부서는 "주소 없음".
RFP_SMTP_HOST=localhost
RFP_SMTP_PORT=1025
RFP_SMTP_USER=
RFP_SMTP_PASSWORD=
RFP_MAIL_FROM=rfp-agent@example.com
RFP_MAIL_COST=cost@example.com
RFP_MAIL_QUALITY=quality@example.com
RFP_MAIL_SALES=sales@example.com
